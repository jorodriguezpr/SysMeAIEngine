# Copy this file to .env and edit as needed.

# ── Server ────────────────────────────────────────────────────────────────────
ENGINE_HOST=127.0.0.1
ENGINE_PORT=11534
# Set to require an X-API-Key / Authorization: Bearer token on API + dashboard
ENGINE_API_KEY=

# ── Storage layout (all relative to this project unless absolute) ─────────────
ENGINE_MODELS_DIR=models
ENGINE_DATA_DIR=data
ENGINE_DATASETS_DIR=data/datasets
ENGINE_CHUNKS_DIR=data/chunks
ENGINE_RAW_DIR=data/raw
ENGINE_CHECKPOINTS_DIR=models/checkpoints
ENGINE_WEIGHTS_DIR=models/weights

# ── Providers / model defaults ────────────────────────────────────────────────
ENGINE_DEFAULT_MODEL=minilm
ENGINE_DEFAULT_PROVIDER=minilm
# HF token (for private models). Leave blank for public models.
HF_TOKEN=

# ── Trainer defaults ──────────────────────────────────────────────────────────
ENGINE_TRAIN_METHOD=lora
ENGINE_TRAIN_EPOCHS=1
ENGINE_TRAIN_LR=0.0002
ENGINE_TRAIN_BATCH=1
ENGINE_TRAIN_GRAD_ACCUM=8
ENGINE_MAX_SEQ_LEN=1024

# OCR for scanned PDF pages / image files (needs requirements-ocr.txt).
# auto = use it when installed; off = never (text-layer extraction only)
ENGINE_OCR=auto

# ── Self-learning agent ───────────────────────────────────────────────────────
# Max pages to scrape per `agent run`
ENGINE_AGENT_MAX_PAGES=6
# Seconds between runs (used by the optional background scheduler)
ENGINE_AGENT_INTERVAL_S=3600
# Domain allow-list (comma separated, substrings match). Empty = allow all (not recommended).
ENGINE_AGENT_ALLOWLIST=
# Outbound UA used for scraping
ENGINE_AGENT_UA=SysMeAIEngine/1.0 (+local; contact: admin@localhost)

# ── Logging ───────────────────────────────────────────────────────────────────
ENGINE_LOG_LEVEL=INFO

# ── Dashboard auth (optional) ────────────────────────────────────────────────
# Comma-separated list of "user:password" pairs for /ui/* Basic Auth. Empty = no auth.
ENGINE_UI_AUTH=
